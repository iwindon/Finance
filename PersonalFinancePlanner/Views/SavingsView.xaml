<UserControl x:Class="PersonalFinancePlanner.Views.SavingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             Background="{StaticResource BackgroundBrush}">

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0" 
                  Text="Savings Tracker"
                  FontSize="32"
                  FontWeight="Bold"
                  Foreground="{StaticResource DarkBlueBrush}"
                  Margin="0,0,0,20"/>

        <!-- Summary Cards -->
        <UniformGrid Grid.Row="1" 
                    Rows="1" 
                    Columns="2"
                    Margin="0,0,0,20">

            <Border Background="{StaticResource CardBackgroundBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="2"
                    CornerRadius="10"
                    Padding="20"
                    Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="🏦 Current Balance"
                              FontSize="14"
                              Foreground="{StaticResource TextSecondaryBrush}"
                              FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding CurrentBalance, StringFormat=C2}"
                              FontSize="32"
                              FontWeight="Bold"
                              Foreground="{StaticResource PrimaryBlueBrush}"
                              Margin="0,10,0,0"/>
                </StackPanel>
            </Border>

            <Border Background="{StaticResource CardBackgroundBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="2"
                    CornerRadius="10"
                    Padding="20"
                    Margin="10,0,0,0">
                <StackPanel>
                    <TextBlock Text="📈 Total Change"
                              FontSize="14"
                              Foreground="{StaticResource TextSecondaryBrush}"
                              FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding TotalChange, StringFormat=C2}"
                              FontSize="32"
                              FontWeight="Bold"
                              Foreground="#4CAF50"
                              Margin="0,10,0,0"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- Add Entry Form -->
        <Border Grid.Row="2"
                Background="{StaticResource CardBackgroundBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="2"
                CornerRadius="10"
                Padding="20"
                Margin="0,0,0,20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                          Text="➕ Add Savings Entry"
                          FontSize="18"
                          FontWeight="Bold"
                          Foreground="{StaticResource DarkBlueBrush}"
                          Margin="0,0,0,15"/>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Label Grid.Column="0" Content="Date:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <DatePicker Grid.Column="1" 
                               SelectedDate="{Binding EntryDate}" 
                               Margin="0,0,15,0"
                               Width="150"/>

                    <Label Grid.Column="2" Content="Balance:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBox Grid.Column="3" 
                            Text="{Binding Balance, TargetNullValue=''}"
                            Style="{StaticResource ModernTextBoxStyle}"
                            Width="150"
                            Margin="0,0,15,0"
                            GotKeyboardFocus="NumericTextBox_GotKeyboardFocus"
                            PreviewMouseLeftButtonDown="NumericTextBox_PreviewMouseLeftButtonDown"/>

                    <Label Grid.Column="4" Content="Notes:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBox Grid.Column="5" 
                            Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                            Style="{StaticResource ModernTextBoxStyle}"
                            Margin="0,0,15,0"/>

                    <Button Grid.Column="6"
                           Content="Add Entry"
                           Command="{Binding AddEntryCommand}"
                           Style="{StaticResource ModernButtonStyle}"/>
                </Grid>
            </Grid>
        </Border>

        <!-- Chart and Entries List -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="400"/>
            </Grid.ColumnDefinitions>

            <!-- Savings Chart -->
            <Border Grid.Column="0"
                    Background="{StaticResource CardBackgroundBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="2"
                    CornerRadius="10"
                    Padding="20"
                    Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="Savings Balance Over Time"
                              FontSize="18"
                              FontWeight="Bold"
                              Foreground="{StaticResource DarkBlueBrush}"
                              Margin="0,0,0,15"/>
                    <lvc:CartesianChart Series="{Binding SavingsChartSeries}"
                                       YAxes="{Binding SavingsChartYAxes}"
                                       XAxes="{Binding SavingsChartXAxes}"
                                       Height="400"/>
                </StackPanel>
            </Border>

            <!-- Entries List -->
            <Border Grid.Column="1"
                    Background="{StaticResource CardBackgroundBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="2"
                    CornerRadius="10"
                    Padding="20"
                    Margin="10,0,0,0">
                <StackPanel>
                    <TextBlock Text="Savings History"
                              FontSize="18"
                              FontWeight="Bold"
                              Foreground="{StaticResource DarkBlueBrush}"
                              Margin="0,0,0,15"/>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="400">
                        <ItemsControl ItemsSource="{Binding SavingsEntries}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource BorderBrush}"
                                           BorderThickness="0,0,0,1"
                                           Padding="0,15">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding Date, StringFormat=d}"
                                                          FontSize="12"
                                                          Foreground="{StaticResource TextSecondaryBrush}"/>
                                                <TextBlock Text="{Binding Balance, StringFormat=C2}"
                                                          FontSize="20"
                                                          FontWeight="Bold"
                                                          Foreground="{StaticResource PrimaryBlueBrush}"
                                                          Margin="0,5,0,0"/>
                                                <TextBlock Text="{Binding Notes}"
                                                          FontSize="12"
                                                          Foreground="{StaticResource TextSecondaryBrush}"
                                                          TextWrapping="Wrap"
                                                          Margin="0,5,0,0"
                                                          Visibility="{Binding Notes, Converter={StaticResource StringToVisibilityConverter}}"/>
                                            </StackPanel>

                                            <Button Grid.Column="1"
                                                   Content="×"
                                                   Command="{Binding DataContext.DeleteEntryCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                   CommandParameter="{Binding}"
                                                   Background="#E53935"
                                                   Foreground="White"
                                                   FontSize="20"
                                                   FontWeight="Bold"
                                                   Width="30"
                                                   Height="30"
                                                   BorderThickness="0"
                                                   Cursor="Hand"
                                                   VerticalAlignment="Top"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>


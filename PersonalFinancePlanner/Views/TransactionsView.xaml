<UserControl x:Class="PersonalFinancePlanner.Views.TransactionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:PersonalFinancePlanner.Models"
             Background="{StaticResource BackgroundBrush}">

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0" 
                  Text="Transactions"
                  FontSize="32"
                  FontWeight="Bold"
                  Foreground="{StaticResource DarkBlueBrush}"
                  Margin="0,0,0,20"/>

        <!-- Add Transaction Form -->
        <Border Grid.Row="1"
                Background="{StaticResource CardBackgroundBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="2"
                CornerRadius="10"
                Padding="20"
                Margin="0,0,0,20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                          Text="➕ Add New Transaction"
                          FontSize="18"
                          FontWeight="Bold"
                          Foreground="{StaticResource DarkBlueBrush}"
                          Margin="0,0,0,15"/>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Label Grid.Column="0" Content="Date:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <DatePicker Grid.Column="1" SelectedDate="{Binding TransactionDate}" Margin="0,0,15,0"/>

                    <Label Grid.Column="2" Content="Description:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBox Grid.Column="3" 
                            Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                            Style="{StaticResource ModernTextBoxStyle}"
                            Margin="0,0,15,0"/>

                    <Label Grid.Column="4" Content="Amount:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBox Grid.Column="5" 
                            Text="{Binding Amount, TargetNullValue=''}"
                            Style="{StaticResource ModernTextBoxStyle}"
                            Width="100"
                            Margin="0,0,15,0"
                            GotKeyboardFocus="NumericTextBox_GotKeyboardFocus"
                            PreviewMouseLeftButtonDown="NumericTextBox_PreviewMouseLeftButtonDown"/>

                    <Label Grid.Column="6" Content="Category:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <ComboBox Grid.Column="7"
                             ItemsSource="{Binding Categories}"
                             SelectedItem="{Binding SelectedCategory}"
                             Width="150"
                             Padding="10,8"
                             FontSize="14"
                             Margin="0,0,15,0"/>

                    <StackPanel Grid.Column="8" Orientation="Vertical">
                        <RadioButton Content="Expense" 
                                    IsChecked="True"
                                    GroupName="TransactionType"
                                    Margin="0,0,0,3"
                                    Checked="ExpenseRadioButton_Checked"/>
                        <RadioButton Content="Income"
                                    GroupName="TransactionType"
                                    Margin="0,0,0,3"
                                    Checked="IncomeRadioButton_Checked"/>
                        <RadioButton Content="Savings"
                                    GroupName="TransactionType"
                                    Margin="0,0,0,3"
                                    Checked="SavingsRadioButton_Checked"/>
                        <RadioButton Content="Debt Payment"
                                    GroupName="TransactionType"
                                    Checked="DebtPaymentRadioButton_Checked"/>
                    </StackPanel>
                </Grid>

                <!-- Credit Card Selector (visible only for Debt Payment) -->
                <Grid Grid.Row="2" Margin="0,15,0,0" Name="CreditCardSelectorPanel" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Label Grid.Column="0" Content="Credit Card:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <ComboBox Grid.Column="1"
                             ItemsSource="{Binding CreditCardNames}"
                             SelectedItem="{Binding SelectedCreditCard}"
                             Width="250"
                             HorizontalAlignment="Left"
                             Padding="10,8"
                             FontSize="14"
                             Margin="0,0,15,0"/>

                    <Button Grid.Column="2"
                            Content="➕ Add Transaction"
                            Command="{Binding AddTransactionCommand}"
                            Style="{StaticResource ModernButtonStyle}"
                            Background="{StaticResource AccentBlueBrush}"
                            Padding="25,12"
                            FontSize="16"
                            FontWeight="Bold"/>
                </Grid>
            </Grid>
        </Border>

        <!-- Transaction Actions and List -->
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Action Buttons -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
                <Button Content="Add Transaction"
                       Command="{Binding AddTransactionCommand}"
                       Style="{StaticResource ModernButtonStyle}"/>
                <Button Content="Import CSV"
                       Command="{Binding ImportCsvCommand}"
                       Style="{StaticResource ModernButtonStyle}"
                       Background="{StaticResource AccentBlueBrush}"/>

                <Label Content="Filter by Category:" VerticalAlignment="Center" Margin="30,0,10,0"/>
                <ComboBox ItemsSource="{Binding Categories}"
                         SelectedItem="{Binding FilterCategory}"
                         Width="150"
                         Padding="10,8"
                         FontSize="14"/>
            </StackPanel>

            <!-- Transactions List -->
            <Border Grid.Row="1"
                    Background="{StaticResource CardBackgroundBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="2"
                    CornerRadius="10"
                    Padding="0">
                <DataGrid ItemsSource="{Binding FilteredTransactions}"
                         AutoGenerateColumns="False"
                         CanUserAddRows="False"
                         RowHeight="40"
                         HeadersVisibility="Column"
                         GridLinesVisibility="Horizontal"
                         BorderThickness="0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Date" 
                                           Binding="{Binding Date, StringFormat=d}"
                                           Width="100"/>
                        <DataGridTextColumn Header="Description" 
                                           Binding="{Binding Description}"
                                           Width="*"/>
                        <DataGridTextColumn Header="Category" 
                                           Binding="{Binding Category}"
                                           Width="150"/>
                        <DataGridTextColumn Header="Amount" 
                                           Binding="{Binding Amount, StringFormat=C2}"
                                           Width="120"/>
                        <DataGridTextColumn Header="Type" 
                                           Binding="{Binding Type}"
                                           Width="100"/>
                        <DataGridTemplateColumn Header="Actions" Width="150">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="Edit"
                                               Command="{Binding DataContext.EditTransactionCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                               CommandParameter="{Binding}"
                                               Background="{StaticResource AccentBlueBrush}"
                                               Foreground="White"
                                               BorderThickness="0"
                                               Padding="10,5"
                                               Margin="0,0,5,0"
                                               Cursor="Hand"/>
                                        <Button Content="Delete"
                                               Command="{Binding DataContext.DeleteTransactionCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                               CommandParameter="{Binding}"
                                               Background="#E53935"
                                               Foreground="White"
                                               BorderThickness="0"
                                               Padding="10,5"
                                               Cursor="Hand"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>
    </Grid>
</UserControl>


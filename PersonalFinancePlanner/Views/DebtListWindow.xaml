<Window x:Class="PersonalFinancePlanner.Views.DebtListWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="All Debts Overview"
        Height="600"
        Width="900"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" 
                Background="{StaticResource PrimaryBlueBrush}"
                CornerRadius="10"
                Padding="20"
                Margin="0,0,0,20">
            <StackPanel>
                <TextBlock Text="💳 All Debts Overview" 
                          FontSize="24" 
                          FontWeight="Bold"
                          Foreground="White"
                          HorizontalAlignment="Center"/>
                <TextBlock Text="Complete list of your loans and credit cards" 
                          FontSize="14" 
                          Foreground="#E3F2FD"
                          HorizontalAlignment="Center"
                          Margin="0,5,0,0"/>
            </StackPanel>
        </Border>

        <!-- Debts DataGrid -->
        <Border Grid.Row="1" 
                Background="White"
                CornerRadius="10"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                Padding="10">
            <DataGrid ItemsSource="{Binding CreditCards}"
                     AutoGenerateColumns="False"
                     IsReadOnly="True"
                     CanUserAddRows="False"
                     CanUserDeleteRows="False"
                     AlternatingRowBackground="#F5F5F5"
                     GridLinesVisibility="Horizontal"
                     HeadersVisibility="Column">
                <DataGrid.Columns>
                    <!-- Name Column -->
                    <DataGridTextColumn Header="Card/Loan Name" 
                                       Binding="{Binding Name}"
                                       Width="*"
                                       MinWidth="150">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Padding" Value="5"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Balance (Principal) Column -->
                    <DataGridTextColumn Header="Balance (Principal)" 
                                       Binding="{Binding Balance, StringFormat=C2}"
                                       Width="Auto"
                                       MinWidth="120">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Padding" Value="5"/>
                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Foreground" Value="#D32F2F"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Interest Rate Column -->
                    <DataGridTextColumn Header="Interest Rate" 
                                       Binding="{Binding InterestRate, StringFormat={}{0:N2}%}"
                                       Width="Auto"
                                       MinWidth="100">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Padding" Value="5"/>
                                <Setter Property="HorizontalAlignment" Value="Right"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Minimum Payment Column -->
                    <DataGridTextColumn Header="Minimum Payment" 
                                       Binding="{Binding MinimumPayment, StringFormat=C2}"
                                       Width="Auto"
                                       MinWidth="120">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Padding" Value="5"/>
                                <Setter Property="HorizontalAlignment" Value="Right"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Due Date Column -->
                    <DataGridTextColumn Header="Due Date" 
                                       Binding="{Binding DueDate, StringFormat=MM/dd/yyyy}"
                                       Width="Auto"
                                       MinWidth="100">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Padding" Value="5"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>

                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Height" Value="35"/>
                    </Style>
                </DataGrid.RowStyle>
            </DataGrid>
        </Border>

        <!-- Summary Section -->
        <Border Grid.Row="2"
                Background="#E3F2FD"
                CornerRadius="10"
                Padding="15"
                Margin="0,20,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" HorizontalAlignment="Left">
                    <TextBlock Text="Total Debts:" FontSize="12" Foreground="#555"/>
                    <TextBlock Text="{Binding TotalDebts}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource PrimaryBlueBrush}"/>
                </StackPanel>

                <StackPanel Grid.Column="1" HorizontalAlignment="Left">
                    <TextBlock Text="Total Balance:" FontSize="12" Foreground="#555"/>
                    <TextBlock Text="{Binding TotalBalance, StringFormat=C2}" FontSize="18" FontWeight="Bold" Foreground="#D32F2F"/>
                </StackPanel>

                <Button Grid.Column="2" 
                       Content="Close"
                       Click="CloseButton_Click"
                       Style="{StaticResource ModernButtonStyle}"
                       Padding="20,8"
                       VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>

<Window x:Class="DebtPayoffCalculator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:DebtPayoffCalculator.ViewModels"
        xmlns:views="clr-namespace:DebtPayoffCalculator.Views"
        Title="Personal Finance Planner" 
        Height="850" 
        Width="1400"
        Background="{StaticResource BackgroundBrush}"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized">

    <Window.DataContext>
        <vm:NavigationViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <!-- Data Templates for Views -->
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:TransactionsViewModel}">
            <views:TransactionsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:BudgetViewModel}">
            <views:BudgetView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DebtViewModel}">
            <views:DebtView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SavingsViewModel}">
            <views:SavingsView/>
        </DataTemplate>

        <!-- Navigation Button Style -->
        <Style x:Key="NavButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="20,15"/>
            <Setter Property="Margin" Value="0,5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                            VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource LightBlueBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar Navigation -->
        <Border Grid.Column="0" 
                Background="{StaticResource DarkBlueBrush}"
                Padding="0">
            <StackPanel>
                <!-- App Title -->
                <Border Background="{StaticResource PrimaryBlueBrush}"
                        Padding="20,30">
                    <StackPanel>
                        <TextBlock Text="💰 Personal" 
                                  FontSize="24" 
                                  FontWeight="Bold"
                                  Foreground="White"
                                  HorizontalAlignment="Center"/>
                        <TextBlock Text="Finance Planner" 
                                  FontSize="24" 
                                  FontWeight="Bold"
                                  Foreground="White"
                                  HorizontalAlignment="Center"
                                  Margin="0,0,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Navigation Buttons -->
                <StackPanel Margin="15,30,15,15">
                    <Button Content="🏠 Dashboard"
                            Command="{Binding NavigateToDashboardCommand}"
                            Style="{StaticResource NavButtonStyle}"/>

                    <Button Content="💳 Transactions"
                            Command="{Binding NavigateToTransactionsCommand}"
                            Style="{StaticResource NavButtonStyle}"/>

                    <Button Content="📊 Budget"
                            Command="{Binding NavigateToBudgetCommand}"
                            Style="{StaticResource NavButtonStyle}"/>

                    <Button Content="💰 Debt Payoff"
                            Command="{Binding NavigateToDebtCommand}"
                            Style="{StaticResource NavButtonStyle}"/>

                    <Button Content="🏦 Savings"
                            Command="{Binding NavigateToSavingsCommand}"
                            Style="{StaticResource NavButtonStyle}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Main Content Area -->
        <ContentControl Grid.Column="1" 
                       Content="{Binding CurrentView}"
                       Margin="0"/>
    </Grid>
</Window>
